{
  "description": "Set includeReverted to the string \"true\". includeReverted must be a boolean, so the request fails with -32602. See MIP-16 eth_queryTraces Filter.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTraces",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "fields": {
          "traces": [
            "traceAddress"
          ]
        },
        "filter": {
          "includeReverted": "true"
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
