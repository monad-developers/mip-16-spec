  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryBlocks",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "fields": {
          "blocks": [
            "number"
          ]
        },
        "order": "ascending"
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
