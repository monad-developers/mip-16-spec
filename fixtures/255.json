{
  "description": "Filter traces by includeReverted null. A filter value must not be null, so the request fails with -32602. null is not the same as omitting includeReverted. See MIP-16 Filters.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTraces",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "filter": {
          "includeReverted": null
        },
        "fields": {
          "traces": [
            "traceAddress"
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
