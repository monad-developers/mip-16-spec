{
  "description": "Filter logs by topics [[]]. A topic array at a position must not be empty, so the request fails with -32602. Use null for a wildcard at a position. See MIP-16 eth_queryLogs Filter.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": [
      {
        "fromBlock": "0x2faf08b",
        "toBlock": "0x2faf08b",
        "fields": {
          "logs": [
            "blockNumber",
            "logIndex",
            "transactionIndex",
            "address",
            "topics",
            "data"
          ]
        },
        "filter": {
          "topics": [
            []
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
