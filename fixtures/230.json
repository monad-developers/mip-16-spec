{
  "description": "Filter transactions by to null to select contract creations. null is not a valid filter value, so the request fails with -32602. See MIP-16 Filters.",
  "undecided": true,
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransactions",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "filter": {
          "to": null
        },
        "fields": {
          "transactions": [
            "hash"
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
