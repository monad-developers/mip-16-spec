{
  "description": "Send params as an object. params must be an array with one element, so the request fails with -32602. See MIP-16 Request.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": {
      "fromBlock": "0x2faf091",
      "toBlock": "0x2faf091",
      "fields": {
        "logs": [
          "logIndex"
        ]
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
