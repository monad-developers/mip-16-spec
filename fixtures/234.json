{
  "description": "Filter logs by address null. A filter value must not be null, so the request fails with -32602. See MIP-16 Filters.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": [
      {
        "fromBlock": "0x2faf08b",
        "toBlock": "0x2faf08b",
        "filter": {
          "address": null
        },
        "fields": {
          "logs": [
            "blockNumber",
            "logIndex",
            "transactionIndex",
            "address",
            "topics",
            "data"
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
