{
  "description": "Filter transactions by a to array that contains null. null is not a valid address in a filter array, as in eth_getLogs, so the request fails with -32602. See MIP-16 Filters.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransactions",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "filter": {
          "to": [
            "0x9f16b181103c93a587f1235aa3982a64126f323d",
            null
          ]
        },
        "fields": {
          "transactions": [
            "hash"
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
