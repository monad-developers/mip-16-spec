  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "fields": {
          "logs": []
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
