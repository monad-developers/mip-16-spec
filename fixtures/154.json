{
  "description": "Filter transfers by selector. eth_queryTransfers has no selector filter, so the request fails with -32602. See MIP-16 eth_queryTransfers Filter.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransfers",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "fields": {
          "transfers": [
            "traceAddress"
          ]
        },
        "filter": {
          "selector": "0x6463ffd1"
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
