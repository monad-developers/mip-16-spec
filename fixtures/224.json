{
  "description": "Filter logs by an empty address array. A filter array must not be empty, so the request fails with -32602. See MIP-16 Filters.",
  "undecided": true,
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "filter": {
          "address": []
        },
        "fields": {
          "logs": [
            "logIndex"
          ]
        }
      }
    ]
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "Invalid params"
    }
  }
}
