{
  "description": "Filter logs by an empty address array. As in eth_getLogs, an empty filter array places no constraint, so the result has the same logs as 007.json. See MIP-16 Filters.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryLogs",
    "params": [
      {
        "fromBlock": "0x2faf091",
        "toBlock": "0x2faf091",
        "filter": {
          "address": []
