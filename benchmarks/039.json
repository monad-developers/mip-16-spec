{
  "description": "Filter by recipient (staking precompile) over 10,000,000 blocks.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTraces",
    "params": [
      {
        "fromBlock": "0x2faf080",
        "toBlock": "0x39386ff",
        "target": "0x64",
        "filter": {
          "to": "0x0000000000000000000000000000000000001000"
        },
        "fields": {
          "traces": [
            "blockNumber",
            "transactionIndex",
            "traceAddress",
            "from",
            "to",
            "input",
            "output"
          ]
        }
      }
    ]
  }
}
