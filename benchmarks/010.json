{
  "description": "Filter by a recipient contract (USDC) over 100,000 blocks, and join blocks.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransactions",
    "params": [
      {
        "fromBlock": "0x2faf080",
        "toBlock": "0x2fc771f",
        "target": "0x64",
        "filter": {
          "to": "0x754704bc059f8c67012fed69bc8a327a5aafb603"
        },
        "fields": {
          "transactions": [
            "blockNumber",
            "transactionIndex",
            "to",
            "input",
            "status"
          ],
          "blocks": [
            "number",
            "timestamp"
          ]
        }
      }
    ]
  }
}
