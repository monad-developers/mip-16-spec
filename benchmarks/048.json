{
  "description": "Selected transfer fields over 1,000 dense blocks, and join transactions and blocks.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransfers",
    "params": [
      {
        "fromBlock": "0x23f8bd8",
        "toBlock": "0x23f8fbf",
        "target": "0x64",
        "fields": {
          "transfers": [
            "from",
            "to",
            "value",
            "blockNumber"
          ],
          "transactions": [
            "hash"
          ],
          "blocks": [
            "number"
          ]
        }
      }
    ]
  }
}
