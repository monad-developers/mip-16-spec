{
  "description": "Filter by recipient (WMON) over 1,000,000 blocks.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransfers",
    "params": [
      {
        "fromBlock": "0x2faf080",
        "toBlock": "0x30a32bf",
        "target": "0x64",
        "filter": {
          "to": "0x3bd359c1119da7da1d913d1c4d2b7c461115433a"
        },
        "fields": {
          "transfers": [
            "blockNumber",
            "transactionIndex",
            "traceAddress",
            "type",
            "from",
            "value"
          ]
        }
      }
    ]
  }
}
