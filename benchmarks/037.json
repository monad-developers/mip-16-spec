{
  "description": "Filter by recipient (WMON) and include reverted frames over 100,000 blocks.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTraces",
    "params": [
      {
        "fromBlock": "0x2faf080",
        "toBlock": "0x2fc771f",
        "target": "0x64",
        "filter": {
          "to": "0x3bd359c1119da7da1d913d1c4d2b7c461115433a",
          "includeReverted": true
        },
        "fields": {
          "traces": [
            "blockNumber",
            "transactionIndex",
            "traceAddress",
            "to",
            "error",
            "reverted"
          ]
        }
      }
    ]
  }
}
