{
  "description": "All transaction and block fields over 1,000 dense blocks, newest first.",
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "eth_queryTransactions",
    "params": [
      {
        "fromBlock": "0x23f8fbf",
        "toBlock": "0x23f8bd8",
        "order": "desc",
        "target": "0x64",
        "fields": {
          "transactions": "all",
          "blocks": "all"
        }
      }
    ]
  }
}
